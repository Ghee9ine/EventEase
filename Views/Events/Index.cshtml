@model IEnumerable<EventEase.Models.Event>

<h2>Events List</h2>

<p>
    <a href="/Events/Create">Add New Event</a>
</p>

<table border="1" cellpadding="8">
    <tr>
        <th>Event Name</th>
        <th>Venue</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th>Status</th>
        <th>Actions</th>
    </tr>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Name</td>
            <td>@e.Venue?.Name</td>
            <td>@e.StartDate</td>
            <td>@e.EndDate</td>
            <td>@e.Status</td>
            <td>
                <a href="/Events/Edit/@e.EventId">Edit</a> |
                <a href="/Events/Delete/@e.EventId">Delete</a>
            </td>
        </tr>
    }
</table>

@if (!Model.Any())
{
    <p>No events yet. Click "Add New Event" to create one.</p>
}