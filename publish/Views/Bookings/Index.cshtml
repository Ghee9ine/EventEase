@model IEnumerable<EventEase.Models.Booking>

<h2>Bookings - Consolidated View</h2>

<form method="get" action="/Bookings/Search" style="margin-bottom:20px;">
    <input type="text" name="searchTerm" placeholder="Search by Booking ID or Event Name" style="width:300px;" value="@ViewBag.SearchTerm" />
    <button type="submit">Search</button>
    <a href="/Bookings">Show All</a>
</form>

@if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
{
    <p>Showing results for: <strong>@ViewBag.SearchTerm</strong></p>
}

<table border="1" cellpadding="8">
    <thead>
        <tr>
            <th>Booking ID</th>
            <th>Customer Name</th>
            <th>Customer Email</th>
            <th>Event Name</th>
            <th>Venue Name</th>
            <th>Event Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.BookingReference</td>
                <td>@b.CustomerName</td>
                <td>@b.CustomerEmail</td>
                <td>@(b.Event?.Name ?? "N/A")</td>
                <td>@(b.Event?.Venue?.Name ?? "N/A")</td>
                <td>@(b.Event?.StartDate.ToString("yyyy-MM-dd") ?? "N/A")</td>
                <td>@b.Status</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>No bookings found. Create a booking first.</p>
}