@model EventEase.Models.Event

<h2>Event Details</h2>

<div>
    <p><strong>Event Name:</strong> @Model.Name</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Start Date:</strong> @Model.StartDate</p>
    <p><strong>End Date:</strong> @Model.EndDate</p>
    <p><strong>Venue:</strong> @Model.Venue?.Name</p>
    <p><strong>Status:</strong> @Model.Status</p>
</div>

<a href="/Events/Edit/@Model.EventId">Edit</a> |
<a href="/Events">Back to List</a>