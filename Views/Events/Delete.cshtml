@model EventEase.Models.Event

<h2>Delete Event</h2>

@if (TempData["Error"] != null)
{
    <p style="color:red; font-weight:bold;">@TempData["Error"]</p>
}

<h3>Are you sure you want to delete this event?</h3>

<div>
    <p><strong>Event Name:</strong> @Model.Name</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Start Date:</strong> @Model.StartDate</p>
    <p><strong>End Date:</strong> @Model.EndDate</p>
    <p><strong>Venue:</strong> @Model.Venue?.Name</p>
    <p><strong>Status:</strong> @Model.Status</p>
</div>

@if (TempData["Error"] == null)
{
    <form method="post">
        <input type="hidden" asp-for="EventId" />
        <button type="submit">Yes, Delete</button>
        <a href="/Events">Cancel</a>
    </form>
}
else
{
    <a href="/Events">Back to Events</a>
}