@model EventEase.Models.Booking

<h2>Create Booking</h2>

<form method="post">
    <div>
        <label>Customer Name:</label><br />
        <input asp-for="CustomerName" required />
    </div>
    
    <div>
        <label>Customer Email:</label><br />
        <input asp-for="CustomerEmail" type="email" required />
    </div>
    
    <div>
        <label>Customer Phone:</label><br />
        <input asp-for="CustomerPhone" />
    </div>
    
    <div>
        <label>Select Event:</label><br />
        <select asp-for="EventId" required>
            <option value="">-- Select Event --</option>
            @foreach (var ev in ViewBag.Events)
            {
                <option value="@ev.EventId">@ev.Name - @ev.Venue?.Name - @ev.StartDate.ToString("yyyy-MM-dd")</option>
            }
        </select>
    </div>
    
    <br />
    <button type="submit">Create Booking</button>
    <a href="/Bookings">Cancel</a>
</form>